---
import Base from "@layouts/Base.astro";
import Wordmark from "@components/Wordmark.astro";
---

<Base title="Page not found | Nerdshouse" description="This page doesn't exist. Try the homepage, our work or the contact page." noindex>
  <section class="nf s-dark">
    <div class="wrap">
      <p class="mono nf-code"><span class="dot" data-state="fail"></span> 404 · route not found</p>
      <h1 class="display-l" style="margin-top:20px">This page isn't running.</h1>
      <p class="lede" style="margin-top:24px">The link may be old, or the page has moved in our redesign. These still work:</p>
      <ul class="nf-links">
        <li><a href="/">Home</a></li>
        <li><a href="/work">Work</a></li>
        <li><a href="/#capabilities">What we build</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <div class="nf-mark" aria-hidden="true"><Wordmark size="m" state="fail" /></div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(72px, 12vw, 180px);
  }
  .nf-code {
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--fail);
  }
  .nf-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .nf-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 8px 18px;
    border: 1px solid var(--ink-line);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  .nf-links a:hover {
    border-color: var(--ink-text);
  }
  .nf-mark {
    margin-top: 56px;
  }
</style>
