---
import Base from "@layouts/Base.astro";
import Hero from "@components/home/Hero.astro";
import ProofStrip from "@components/home/ProofStrip.astro";
import Capabilities from "@components/home/Capabilities.astro";
import EngineeringExplainer from "@components/home/EngineeringExplainer.astro";
import SelectedWork from "@components/home/SelectedWork.astro";
import Process from "@components/home/Process.astro";
import Principles from "@components/home/Principles.astro";
import CtaBand from "@components/CtaBand.astro";
import { SITE } from "@data/site";

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  publisher: { "@id": `${SITE.url}/#organization` },
};
---

<Base
  title="Nerdshouse — Technology & AI Engineering Partner in Surat, India"
  description={SITE.defaultDescription}
  jsonLd={[website]}
>
  <Hero />
  <ProofStrip />
  <Capabilities />
  <EngineeringExplainer />
  <SelectedWork />
  <Process />
  <Principles />
  <CtaBand />
</Base>
