---
import Base from "@layouts/Base.astro";
import Icon from "@components/Icon.astro";
import { SITE } from "@data/site";
---

<Base
  title="Careers at Nerdshouse — Engineering and Design in Surat"
  description="Work with Nerdshouse, a small technology and AI engineering team in Surat, Gujarat. How we hire and how to get in touch."
  breadcrumbs={[{ name: "Careers", path: "/career" }]}
>
  <section class="cr s-dark" aria-labelledby="cr-title">
    <div class="wrap cr-grid">
      <div>
        <p class="eyebrow">Careers</p>
        <h1 id="cr-title" class="display-l" style="margin-top:24px">Build things people rely on.</h1>
      </div>
      <div class="cr-copy">
        <p class="lede">
          We're a small team in Surat building AI workflows, products and business systems for real clients. We hire when we have
          the right work — not to fill seats.
        </p>
        <div class="cr-box">
          <p class="mono cr-h">How to apply</p>
          <p>
            Send a short note and links to work you're proud of — code, products, designs — to
            <a href={`mailto:${SITE.email}?subject=Careers`}>{SITE.email}</a> with “Careers” in the subject. Tell us what you'd like to
            build.
          </p>
          <a href={`mailto:${SITE.email}?subject=Careers`} class="btn btn--primary">Email us <Icon name="arrow" /></a>
        </div>
        <p class="mono faint cr-note">We don't list roles here when none are open.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .cr {
    padding-block: clamp(56px, 8vw, 128px);
  }
  .cr-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1000px) {
    .cr-grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: end;
    }
  }
  .cr-copy {
    display: grid;
    gap: 24px;
  }
  .cr-box {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding: 24px;
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-l);
    background: var(--ink-1);
  }
  .cr-box a:not(.btn) {
    color: var(--signal);
  }
  .cr-h {
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }
  .cr-note {
    font-size: 0.74rem;
  }
</style>
