---
// "Who uses what" — an example operations suite. Select a role to light up the apps it uses.
const apps = [
  { id: "book", t: "Bookings & payments", d: "Site visits, quotations, payment status, partner assignment" },
  { id: "crm", t: "CRM", d: "Leads, reassignment, status history and remarks" },
  { id: "b2b", t: "B2B sales", d: "Dealer accounts, overdue follow-ups, cross-sell" },
  { id: "field", t: "Field sales", d: "Visits with photos, live location, follow-ups" },
  { id: "inv", t: "Inventory", d: "Warehouses, SKUs, purchase orders, reorder planning" },
  { id: "tasks", t: "Tasks", d: "Assigned work, due dates, overdue “red zone”, WhatsApp alerts" },
];
const roles = [
  { id: "owner", t: "Owner", uses: ["book", "crm", "b2b", "field", "inv", "tasks"], d: "Sees everything from one launcher: revenue, pipeline, stock and overdue work." },
  { id: "manager", t: "Admin / manager", uses: ["book", "crm", "b2b", "inv", "tasks"], d: "Approves new users, reassigns leads, manages bookings and stock." },
  { id: "sales", t: "Sales team", uses: ["crm", "b2b", "tasks"], d: "Works only their own leads and accounts, with follow-up reminders." },
  { id: "field", t: "Field team", uses: ["field", "tasks"], d: "Logs visits on the phone, on site, with photos and location." },
  { id: "partner", t: "Fitting partner", uses: ["book"], d: "Receives assigned installation jobs and updates status." },
  { id: "customer", t: "Customer", uses: ["book"], d: "Books a visit, verifies on WhatsApp and pays online." },
];
---

<div class="rm" data-rm>
  <div class="rm-head">
    <p class="mono rm-h">Who uses what · example operations suite</p>
    <span class="label-illustrative">Illustrative</span>
  </div>
  <div class="rm-roles" role="group" aria-label="Choose a role">
    {
      roles.map((r, i) => (
        <button type="button" class="rm-role" aria-pressed={i === 0 ? "true" : "false"} data-role={r.id} data-uses={r.uses.join(" ")} data-desc={r.d}>
          {r.t}
        </button>
      ))
    }
  </div>
  <p class="rm-desc" role="status" aria-live="polite" data-rm-desc>{roles[0].d}</p>
  <div class="rm-board">
    <ul class="rm-apps">
      {
        apps.map((a) => (
          <li class="rm-app is-on" data-app={a.id}>
            <span class="rm-app-t">
              <span class="dot" data-state="ok" />
              {a.t}
            </span>
            <span class="rm-app-d">{a.d}</span>
          </li>
        ))
      }
    </ul>
    <div class="rm-core">
      <p class="mono">Shared data</p>
      <p>One record per customer, order, payment and job — every app reads the same truth.</p>
      <p class="mono rm-core-sub">Roles per user · admin approval · activity history · CSV export</p>
    </div>
  </div>
  <noscript><p class="rm-noscript muted">Roles: {roles.map((r) => `${r.t} — ${r.d}`).join(" ")}</p></noscript>
</div>

<style>
  .rm {
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-l);
    background: var(--ink-1);
    padding: clamp(16px, 2.5vw, 28px);
    display: grid;
    gap: 16px;
  }
  .rm-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rm-h {
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }
  .rm-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rm-role {
    min-height: 42px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--ink-line);
    background: transparent;
    color: var(--ink-mute);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .rm-role:hover {
    color: var(--ink-text);
  }
  .rm-role[aria-pressed="true"] {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink-0);
  }
  .rm-desc {
    font-size: 1.05rem;
    min-height: 1.6em;
  }
  .rm-board {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .rm-board {
      grid-template-columns: 1fr 300px;
    }
  }
  .rm-apps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  @media (min-width: 560px) {
    .rm-apps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1200px) {
    .rm-apps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .rm-app {
    display: grid;
    gap: 4px;
    padding: 14px;
    border-radius: 10px;
    border: 1px solid var(--ink-line-soft);
    opacity: 0.35;
    transition: opacity 0.3s var(--ease), border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .rm-app.is-on {
    opacity: 1;
    border-color: rgba(61, 220, 151, 0.35);
    background: rgba(61, 220, 151, 0.04);
  }
  .rm-app:not(.is-on) .dot {
    background: var(--ink-line);
  }
  .rm-app-t {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 650;
  }
  .rm-app-d {
    color: var(--ink-mute);
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .rm-core {
    padding: 18px;
    border-radius: 12px;
    border: 1px solid rgba(255, 106, 43, 0.4);
    background: linear-gradient(180deg, rgba(255, 106, 43, 0.08), transparent);
    display: grid;
    gap: 8px;
    align-content: center;
  }
  .rm-core .mono:first-child {
    color: var(--signal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }
  .rm-core-sub {
    color: var(--ink-faint);
    font-size: 0.72rem;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-rm]");
  if (root) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>("[data-role]")];
    const apps = [...root.querySelectorAll<HTMLElement>("[data-app]")];
    const desc = root.querySelector<HTMLElement>("[data-rm-desc]")!;
    const pick = (b: HTMLButtonElement) => {
      btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      const uses = b.dataset.uses!.split(" ");
      apps.forEach((a) => a.classList.toggle("is-on", uses.includes(a.dataset.app!)));
      desc.textContent = `${b.textContent!.trim()}: ${b.dataset.desc}`;
    };
    btns.forEach((b) => b.addEventListener("click", () => pick(b)));
    pick(btns[0]);
  }
</script>
