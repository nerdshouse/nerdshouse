# Copy to .env for local use. On Vercel, set these per environment (Preview vs Production).

# Every non-production deployment: shows a "Preview" banner and adds noindex,nofollow.
PUBLIC_PREVIEW=true

# GA4 measurement ID. Loaded only when set AND PUBLIC_PREVIEW is not "true".
# Production currently uses G-RD6E4QSQST. Decide on consent before enabling (see private/launch/ANALYTICS_PLAN.md).
PUBLIC_GA4_ID=

# Contact form (optional). Leave unset and the form opens the visitor's email app instead.
# Set only after confirming in the Web3Forms dashboard that this key delivers to nerd@nerdshouse.com,
# and after enabling the dashboard's domain restriction for nerdshouse.com. Public by design.
PUBLIC_WEB3FORMS_KEY=

# Set to "true" only after a real test submission has arrived at nerd@nerdshouse.com.
PUBLIC_FORM_VERIFIED=
